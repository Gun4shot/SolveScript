# Server and database
PORT=5000
NODE_ENV=development
CLIENT_URL=http://127.0.0.1:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/solvescript
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# Session policy. The refresh token keeps an active signed-in session renewable.
JWT_EXPIRE=30m
JWT_REFRESH_EXPIRE=30d

# Google OAuth web client credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# Optional: defaults to 100 in development and 20 in production.
AUTH_RATE_LIMIT_MAX=100

# Set only on the trusted server during the later, optional AI-review phase.
# Students' own Gemini keys are never stored in this variable or in the database.
# GEMINI_MODEL=gemini-2.5-flash

# Public written-paper archive. Serving papers does not require a token.
HF_DATASET_REPO=Sidant/solvescript-caie-papers
# To publish the archive locally, first run: hf auth login
